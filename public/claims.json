[
  {
    "id": "C001",
    "text": "The physical universe has some explanation beyond merely describing its internal events.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C002",
    "text": "The universe is not ultimately self-explanatory.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C003",
    "text": "The universe depends on something that is not identical to the universe.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "dependence",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C004",
    "text": "The existence of physical reality is not a brute fact.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "brute-fact",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C005",
    "text": "The beginning or finite past of the universe points to a cause beyond ordinary physical events.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "causation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C006",
    "text": "The totality of physical reality requires an explanation not contained within that totality.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "totality",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C007",
    "text": "The regularity of nature requires an explanation beyond simply naming physical laws.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "laws",
      "regularity"
    ],
    "dependencyIds": []
  },
  {
    "id": "C008",
    "text": "The initial conditions of the universe were not merely accidental or unexplained.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "initial-conditions",
      "cosmology"
    ],
    "dependencyIds": []
  },
  {
    "id": "C009",
    "text": "The existence of contingent things points to some non-contingent explanatory ground.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "contingency",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C010",
    "text": "A minimal creator or source of the universe exists, even if nothing else is known about it.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "creator",
      "source"
    ],
    "dependencyIds": [
      "C001",
      "C003",
      "C006",
      "C009"
    ]
  },
  {
    "id": "C011",
    "text": "The universe was intentionally caused rather than accidentally caused.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "intention",
      "causation"
    ],
    "dependencyIds": [
      "C010"
    ]
  },
  {
    "id": "C012",
    "text": "The universe was caused by something with goal-directed features.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "teleology",
      "causation"
    ],
    "dependencyIds": [
      "C010",
      "C011"
    ]
  },
  {
    "id": "C013",
    "text": "The structure of the universe is better explained by design than by chance, necessity, or unknown impersonal processes.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "design",
      "explanation"
    ],
    "dependencyIds": [
      "C011",
      "C012"
    ]
  },
  {
    "id": "C014",
    "text": "The apparent fine-tuning of physical constants is evidence of purposeful calibration.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "fine-tuning",
      "design"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C013"
    ]
  },
  {
    "id": "C015",
    "text": "The universe was created for the emergence of life.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "life",
      "purpose"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C014"
    ]
  },
  {
    "id": "C016",
    "text": "The universe was created for the emergence of conscious beings.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "consciousness",
      "purpose"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C014",
      "C015"
    ]
  },
  {
    "id": "C017",
    "text": "The creator had some preference for order over chaos.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "order",
      "preference"
    ],
    "dependencyIds": [
      "C010",
      "C011"
    ]
  },
  {
    "id": "C018",
    "text": "The creator had some preference for life-permitting conditions over non-life-permitting conditions.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "life-permitting",
      "preference"
    ],
    "dependencyIds": [
      "C010",
      "C011",
      "C014"
    ]
  },
  {
    "id": "C019",
    "text": "The creator is more like an intelligent agent than an impersonal force.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "agency",
      "intelligence"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C017"
    ]
  },
  {
    "id": "C020",
    "text": "The creator intentionally set the universe in motion but does not clearly intervene after creation.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "deism",
      "non-intervention"
    ],
    "dependencyIds": [
      "C010",
      "C011"
    ]
  },
  {
    "id": "C021",
    "text": "The creator has something analogous to mind, intention, or awareness.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "mind",
      "awareness"
    ],
    "dependencyIds": [
      "C019"
    ]
  },
  {
    "id": "C022",
    "text": "The creator is aware of the universe after creating it.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "awareness",
      "creation"
    ],
    "dependencyIds": [
      "C021"
    ]
  },
  {
    "id": "C023",
    "text": "The creator is aware of conscious creatures within the universe.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "awareness",
      "humans"
    ],
    "dependencyIds": [
      "C021",
      "C022"
    ]
  },
  {
    "id": "C024",
    "text": "The creator is capable of choosing between alternative possible actions.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "choice",
      "agency"
    ],
    "dependencyIds": [
      "C021"
    ]
  },
  {
    "id": "C025",
    "text": "The creator has purposes related to human beings.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "purpose",
      "humans"
    ],
    "dependencyIds": [
      "C021",
      "C023",
      "C024"
    ]
  },
  {
    "id": "C026",
    "text": "The creator cares about whether humans understand reality accurately.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "truth",
      "humans"
    ],
    "dependencyIds": [
      "C023",
      "C025"
    ]
  },
  {
    "id": "C027",
    "text": "The creator can act within the universe after its initial creation.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "intervention-capacity",
      "agency"
    ],
    "dependencyIds": [
      "C021",
      "C024"
    ]
  },
  {
    "id": "C028",
    "text": "The creator can communicate information to human beings.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "communication",
      "revelation-capacity"
    ],
    "dependencyIds": [
      "C021",
      "C023",
      "C026"
    ]
  },
  {
    "id": "C029",
    "text": "The creator can respond differently to different human actions, prayers, or requests.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "response",
      "prayer-capacity"
    ],
    "dependencyIds": [
      "C023",
      "C024",
      "C027"
    ]
  },
  {
    "id": "C030",
    "text": "The creator is not merely the source of the universe but an ongoing personal agent.",
    "category": "Personal Theism",
    "gradientPosition": 3,
    "specificityWeight": 3,
    "tradition": "general",
    "tags": [
      "personal-theism",
      "agency"
    ],
    "dependencyIds": [
      "C021",
      "C022",
      "C024",
      "C027"
    ]
  },
  {
    "id": "C031",
    "text": "God has intervened in the physical world after the universe began.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "intervention",
      "history"
    ],
    "dependencyIds": [
      "C027",
      "C030"
    ]
  },
  {
    "id": "C032",
    "text": "God can perform public, detectable miracles rather than only private or inward experiences.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "miracle",
      "detection"
    ],
    "dependencyIds": [
      "C027",
      "C031"
    ]
  },
  {
    "id": "C033",
    "text": "God can answer prayer in ways that differ from chance or ordinary causation.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "prayer",
      "intervention",
      "causation"
    ],
    "dependencyIds": [
      "C021",
      "C022",
      "C027",
      "C029"
    ]
  },
  {
    "id": "C034",
    "text": "God can communicate specific moral, historical, or theological information to human beings.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "communication",
      "revelation"
    ],
    "dependencyIds": [
      "C026",
      "C028",
      "C031"
    ]
  },
  {
    "id": "C035",
    "text": "Some prophetic or revelatory claims can be genuinely caused by God rather than merely by human religious imagination.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "prophecy",
      "revelation"
    ],
    "dependencyIds": [
      "C028",
      "C034"
    ]
  },
  {
    "id": "C036",
    "text": "Some sacred texts can preserve information from God without every interpretive tradition about those texts being correct.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "general",
    "tags": [
      "scripture",
      "revelation",
      "interpretation"
    ],
    "dependencyIds": [
      "C034",
      "C035"
    ]
  },
  {
    "id": "C037",
    "text": "The Hebrew Bible can function as a historically and theologically relevant background for evaluating Christian claims.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "Christianity",
    "tags": [
      "Hebrew Bible",
      "background",
      "covenant"
    ],
    "dependencyIds": [
      "C035",
      "C036"
    ]
  },
  {
    "id": "C038",
    "text": "First-century reports about Jesus can be assessed as historical claims rather than only as later community symbolism.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "Christianity",
    "tags": [
      "Jesus",
      "history",
      "method"
    ],
    "dependencyIds": [
      "C031",
      "C036"
    ]
  },
  {
    "id": "C039",
    "text": "Jesus' ministry plausibly included public acts or teachings that his earliest followers reasonably interpreted as signs of divine authority.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "Christianity",
    "tags": [
      "Jesus",
      "miracle",
      "authority"
    ],
    "dependencyIds": [
      "C032",
      "C034",
      "C038"
    ]
  },
  {
    "id": "C040",
    "text": "God has made enough evidence available for humans to identify Christianity as a serious candidate for revealed religion.",
    "category": "Interventionist Theism",
    "gradientPosition": 4,
    "specificityWeight": 4,
    "tradition": "Christianity",
    "tags": [
      "Christianity",
      "evidence",
      "revelation"
    ],
    "dependencyIds": [
      "C026",
      "C034",
      "C036",
      "C038"
    ]
  },
  {
    "id": "C041",
    "text": "The God relevant to Christianity is the God of Israel identified in the Hebrew Bible as YHWH.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "YHWH",
      "Hebrew Bible",
      "Christianity"
    ],
    "dependencyIds": [
      "C037",
      "C040"
    ]
  },
  {
    "id": "C042",
    "text": "Jesus of Nazareth was bodily resurrected after death.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "Jesus",
      "resurrection",
      "history"
    ],
    "dependencyIds": [
      "C031",
      "C032",
      "C038",
      "C039"
    ]
  },
  {
    "id": "C043",
    "text": "The resurrection of Jesus, if substantiated, is best explained as divine vindication rather than as an unknown natural anomaly.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "resurrection",
      "explanation",
      "vindication"
    ],
    "dependencyIds": [
      "C030",
      "C031",
      "C040",
      "C042"
    ]
  },
  {
    "id": "C044",
    "text": "Jesus was not merely a prophet or teacher but uniquely divine in the sense affirmed by historic Christianity.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "Jesus",
      "divinity",
      "Christology"
    ],
    "dependencyIds": [
      "C034",
      "C038",
      "C042",
      "C043"
    ]
  },
  {
    "id": "C045",
    "text": "The incarnation claim that God became human in Jesus is substantiable rather than only a later theological metaphor.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "incarnation",
      "Jesus",
      "Christology"
    ],
    "dependencyIds": [
      "C041",
      "C042",
      "C044"
    ]
  },
  {
    "id": "C046",
    "text": "The crucifixion of Jesus had a divinely intended salvific function.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "crucifixion",
      "atonement",
      "salvation"
    ],
    "dependencyIds": [
      "C025",
      "C034",
      "C042",
      "C044"
    ]
  },
  {
    "id": "C047",
    "text": "The New Testament reliably preserves the central divine claims about Jesus.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "New Testament",
      "Jesus",
      "textual-reliability"
    ],
    "dependencyIds": [
      "C036",
      "C038",
      "C042",
      "C044"
    ]
  },
  {
    "id": "C048",
    "text": "The earliest apostolic proclamation about Jesus was authorized by God rather than merely by human religious enthusiasm.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "apostles",
      "authority",
      "church"
    ],
    "dependencyIds": [
      "C034",
      "C040",
      "C042",
      "C047"
    ]
  },
  {
    "id": "C049",
    "text": "The Holy Spirit continues God's personal agency in Christian life, worship, and moral transformation.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "Holy Spirit",
      "agency",
      "transformation"
    ],
    "dependencyIds": [
      "C030",
      "C033",
      "C044",
      "C048"
    ]
  },
  {
    "id": "C050",
    "text": "Historic Christianity's core claim is true: the triune God has acted through Jesus Christ for human salvation.",
    "category": "Specific Christian Theism",
    "gradientPosition": 5,
    "specificityWeight": 5,
    "tradition": "Christianity",
    "tags": [
      "Trinity",
      "Jesus",
      "salvation",
      "Christianity"
    ],
    "dependencyIds": [
      "C041",
      "C044",
      "C045",
      "C046",
      "C049"
    ]
  }
]
