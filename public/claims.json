    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "consciousness",
      "purpose"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C014",
      "C015"
    ]
  },
  {
    "id": "C017",
    "text": "The creator had some preference for order over chaos.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "order",
      "preference"
    ],
    "dependencyIds": [
      "C010",
      "C011"
    ]
  },
  {
    "id": "C018",
    "text": "The creator had some preference for life-permitting conditions over non-life-permitting conditions.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "life-permitting",
      "preference"
    ],
    "dependencyIds": [
      "C010",
      "C011",
      "C014"
    ]
  },
  {
    "id": "C019",
    "text": "The creator is more like an intelligent agent than an impersonal force.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "agency",
      "intelligence"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C017"
    ]
  },
  {
    "id": "C020",
