[
  {
    "id": "C001",
    "text": "The physical universe has some explanation beyond merely describing its internal events.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C002",
    "text": "The universe is not ultimately self-explanatory.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C003",
    "text": "The universe depends on something that is not identical to the universe.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "dependence",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C004",
    "text": "The existence of physical reality is not a brute fact.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "brute-fact",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C005",
    "text": "The beginning or finite past of the universe points to a cause beyond ordinary physical events.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "cosmology",
      "causation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C006",
    "text": "The totality of physical reality requires an explanation not contained within that totality.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "totality",
      "explanation"
    ],
    "dependencyIds": []
  },
  {
    "id": "C007",
    "text": "The regularity of nature requires an explanation beyond simply naming physical laws.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "laws",
      "regularity"
    ],
    "dependencyIds": []
  },
  {
    "id": "C008",
    "text": "The initial conditions of the universe were not merely accidental or unexplained.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "initial-conditions",
      "cosmology"
    ],
    "dependencyIds": []
  },
  {
    "id": "C009",
    "text": "The existence of contingent things points to some non-contingent explanatory ground.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "contingency",
      "metaphysics"
    ],
    "dependencyIds": []
  },
  {
    "id": "C010",
    "text": "A minimal creator or source of the universe exists, even if nothing else is known about it.",
    "category": "Minimal Deism",
    "gradientPosition": 1,
    "specificityWeight": 1,
    "tradition": "general",
    "tags": [
      "creator",
      "source"
    ],
    "dependencyIds": [
      "C001",
      "C003",
      "C006",
      "C009"
    ]
  },
  {
    "id": "C011",
    "text": "The universe was intentionally caused rather than accidentally caused.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "intention",
      "causation"
    ],
    "dependencyIds": [
      "C010"
    ]
  },
  {
    "id": "C012",
    "text": "The universe was caused by something with goal-directed features.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "teleology",
      "causation"
    ],
    "dependencyIds": [
      "C010",
      "C011"
    ]
  },
  {
    "id": "C013",
    "text": "The structure of the universe is better explained by design than by chance, necessity, or unknown impersonal processes.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "design",
      "explanation"
    ],
    "dependencyIds": [
      "C011",
      "C012"
    ]
  },
  {
    "id": "C014",
    "text": "The apparent fine-tuning of physical constants is evidence of purposeful calibration.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "fine-tuning",
      "design"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C013"
    ]
  },
  {
    "id": "C015",
    "text": "The universe was created for the emergence of life.",
    "category": "Design Deism",
    "gradientPosition": 2,
    "specificityWeight": 2,
    "tradition": "general",
    "tags": [
      "life",
      "purpose"
    ],
    "dependencyIds": [
      "C011",
      "C012",
      "C014"
    ]
  },
  {
    "id": "C016",
    "text": "The universe was created for the emergence of conscious beings.",
